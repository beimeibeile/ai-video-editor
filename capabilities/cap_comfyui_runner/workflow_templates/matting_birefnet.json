{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{input_image}}"
    }
  },
  "2": {
    "class_type": "BiRefNetRMBG",
    "inputs": {
      "image": ["1", 0],
      "model": "{{model_name}}",
      "sensitivity": 1.0,
      "mask_blur": 0,
      "mask_offset": 0,
      "invert_output": false,
      "refine_foreground": false,
      "background": "Alpha",
      "background_color": "#222222"
    }
  },
  "3": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "matting_{{timestamp}}",
      "images": ["2", 0]
    }
  }
}

# ============================================
# AI Video Editor 配置文件模板
# 复制为 .env 并填入实际值
# 注意：.env 包含敏感信息，不要提交到Git
# ============================================

# ── AnySearch 搜索 API ──
# 注册地址：https://www.anysearch.com
ANYSEARCH_API_KEY=
ANYSEARCH_API_ENDPOINT=https://api.anysearch.com

# ── ComfyUI 配置 ──
COMFYUI_ENABLED=true
COMFYUI_ADDRESS=127.0.0.1:8188

# ── 剪映配置 ──
JIANYING_ENABLED=true
JIANYING_PATH=
JIANYING_VERSION=5.9

# ── 输出配置 ──
OUTPUT_DIR=./output
TEMP_DIR=./temp

# ── 调试配置 ──
DEBUG_MODE=false
DRY_RUN=false
